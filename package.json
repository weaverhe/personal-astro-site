{
  "name": "my-astro-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx,.astro,.md,.json",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx,.astro,.md,.json --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "types": "tsc --noEmit && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unit",
    "test:routes": "astro build && vitest run --project routes",
    "test:run": "vitest run --project unit",
    "check": "pn format && pn lint && pn lint:css && pn types && pn test:run && pn test:routes",
    "prepare": "husky",
    "storybook": "storybook dev",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/language-server": "^2.17.2",
    "@storybook-astro/framework": "^1.12.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/builder-vite": "^10.6.2",
    "@types/jsdom": "^30.0.0",
    "cssnano": "^9.8.0",
    "eslint": "^10.12.0",
    "eslint-config-xo": "^5.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss-custom-selectors": "^9.0.4",
    "postcss-html": "^2.0.0",
    "postcss-mixins": "^12.1.2",
    "postcss-preset-env": "^11.6.1",
    "postcss-utilities": "^0.8.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-modern": "^1.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,astro,md,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,astro}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx,astro}": "vitest related --run"
  },
  "browserslist": [
    "defaults"
  ]
}
