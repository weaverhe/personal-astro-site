{
  "name": "my-astro-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx,.astro,.md,.json",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx,.astro,.md,.json --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "types": "tsc --noEmit && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pn format:check && pn lint && pn lint:css && pn types",
    "prepare": "husky",
    "storybook": "storybook dev",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "eslint-config-xo": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@storybook-astro/framework": "^1.12.0",
    "@storybook/builder-vite": "^10.6.2",
    "cssnano": "^9.8.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.6.1",
    "postcss-utilities": "^0.8.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "browserslist": [
    "defaults"
  ]
}
