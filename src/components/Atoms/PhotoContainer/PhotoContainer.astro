---
import {Image} from "astro:assets";
import type {ImageMetadata} from "astro";
import type {HTMLAttributes} from "astro/types";
import type {PaletteColor} from "../../../constants/colors.ts";
import styles from "./PhotoContainer.module.css";

/**
 * A container for displaying photos in various shapes/frame colors.
 */
type Props = HTMLAttributes<"div"> & {
  /**
   * The URL of the image to display.
   */
  image: ImageMetadata;
  /**
   * The alt text for the image.
   */
  alt?: string;
  /**
   * The shape of the photo container.
   */
  shape?: "arch" | "circle" | "square" | "rounded-corners";
  /**
   * The frame color to use. No frame will be applied if not provided.
   */
  frameColor?: PaletteColor;
  /**
   * Whether to add a box shadow.
   */
  shadow?: boolean;
  /**
   * Whether to add a border.
   */
  border?: boolean;
};

const {
  image,
  alt = "",
  shadow = false,
  border = true,
  shape = "square",
  frameColor = "none",
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    styles.container,
    className,
    shadow && styles.shadow,
    border && styles.border,
    styles[shape],
    styles[`frame-${frameColor}`],
  ]}
  {...rest}
>
  <Image src={image} alt={alt} class={styles.image} />
</div>
