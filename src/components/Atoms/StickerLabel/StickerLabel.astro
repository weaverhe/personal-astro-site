---
import type {Polymorphic} from "astro/types";
import type {LightColor} from "../../../constants/colors.ts";
import type {
  ShapeName,
  ShapeColor,
  ShapeAnimation,
} from "../Shape/Shape.constants.ts";
import Shape from "../Shape/Shape.astro";
import styles from "./StickerLabel.module.css";

type StickerLabelTag = "a" | "button" | "span" | "div";

/**
 * A sticker label component featuring text,
 * and an optional sticker element.
 */
type Props<Tag extends StickerLabelTag = "div"> = Polymorphic<{as: Tag}> & {
  /**
   * The HTML tag to render as.
   */
  as?: Tag;
  /**
   * The size of the label.
   */
  size?: "small" | "medium" | "large";
  /**
   * The background color of the label.
   * Text, shadow, and border is always ink.
   */
  color?: LightColor;
  /**
   * The shape of the label.
   */
  corners?: "rectangle" | "pill";
  /**
   * The direction the sticker tilts.
   */
  tilt?: "left" | "right";
  /**
   * The shape to display atop the sticker
   */
  shape?: ShapeName;
  /**
   * The color of the accent shape.
   */
  shapeColor?: ShapeColor;
  /**
   * The animation to apply to the accent shape.
   */
  shapeAnimation?: ShapeAnimation;
};

const {
  as: Element = "div",
  size = "medium",
  color = "peach",
  corners = "rectangle",
  tilt = "left",
  shape,
  shapeColor,
  shapeAnimation,
  class: className,
  ...rest
} = Astro.props;
---

<Element
  class:list={[
    styles.sticker,
    styles[size],
    styles[color],
    styles[corners],
    styles[tilt],
    className,
  ]}
  {...rest}
  aria-hidden="true"
>
  <slot />
  {shape && (
    <div class={styles.shapeContainer}>
      <Shape
        shape={shape}
        color={shapeColor}
        animation={shapeAnimation}
        size="small"
      />
    </div>
  )}
</Element>
